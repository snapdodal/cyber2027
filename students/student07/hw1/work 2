import itertools

ciphertext = "PASTE THE TRANSPOSITION TEXT HERE"   # keep the spaces exactly as they are

with open("words") as file:
    known_words = {line.strip().lower() for line in file if line.strip()}


def english_score(text):
    sentence_words = text.lower().split()
    count = 0

    for word in sentence_words:
        if word in known_words:
            count += 1

    return count


best_score = -1
best_key = None
best_text = ""
keys_tried = 0
n = len(ciphertext)

for length in range(2, 9):                          # number of columns: 2 to 8
    for key in itertools.permutations(range(length)):
        keys_tried += 1

        letters = [""] * n
        pos = 0
        for col in key:                             # columns are read in the order of the key
            size = len(range(col, n, length))       # how many letters are in this column
            letters[col::length] = ciphertext[pos:pos + size]
            pos += size
        current_try = "".join(letters)

        score = english_score(current_try)

        if score > best_score:
            best_score = score
            best_key = key
            best_text = current_try
            print(key, "   score:", score, current_try)   # only prints improvements

print("Best key:", best_key)
print("Best score:", best_score)
print("Best text:", best_text)
print("Keys tried:", keys_tried)
